#!/bin/env sh

function node_setup() {
  echo "Configuring Node using fnm"
  fnm install v24.0.2
  fnm alias v24.0.2 latest
  fnm install v22.15.1
  fnm alias v22.15.1 default
  fnm alias v22.15.1 lts
  fnm use latest
  npm install -g npm
}

function jvm_setup() {
  source "/home/geektimus/.sdkman/bin/sdkman-init.sh"
  sdk install gradle 7.6
  sdk install java 19.0.2-zulu
  sdk install kotlin 1.8.0
  sdk install sbt 1.8.2
  sdk install scala 3.2.2
}

if [ "$#" -ne 1 ]; then
    echo "Illegal number of parameters"
    exit 1
fi

if [[ "$1" == "node" ]]; then
  node_setup
elif [[ "$1" == "jvm" ]]; then
  jvm_setup
else
  echo "Error: Unknown option '$1'"
  exit 2
fi

